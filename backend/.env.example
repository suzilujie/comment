# ────────────────────────────────────────────────────────────────
# comment backend — 环境变量样例
# 用法：复制为 .env 后按实际环境填写（.env 不纳入版本管理）
# ────────────────────────────────────────────────────────────────

# ── 服务 ──
SERVER_HOST=0.0.0.0
SERVER_PORT=15650
LOG_LEVEL=info
LOG_FILE=logs/backend.log

# ── 数据库（PostgreSQL 16） ──
PG_URL=postgres://postgres:postgres@127.0.0.1:5432/comment
PG_POOL_MAX=10

# ── 派单约束（设计文档 §5.1） ──
DAILY_QUOTA_PER_ACCOUNT=20
INTERVAL_MIN_MINUTES=30
INTERVAL_MAX_MINUTES=60
DISPATCH_WINDOW_START=08:00
DISPATCH_WINDOW_END=22:00
GLOBAL_DISPATCH_LIMIT=3
GLOBAL_DISPATCH_WINDOW_SECONDS=300
PER_POST_MIN_INTERVAL_MINUTES=15
RECEIPT_TIMEOUT_MINUTES=15

# ── 心跳 ──
HEARTBEAT_SECONDS=30
HEARTBEAT_JITTER_RATIO=0.1
ONLINE_THRESHOLD_SECONDS=90
OFFLINE_ALERT_THRESHOLD_SECONDS=300
OFFLINE_MANUAL_THRESHOLD_SECONDS=1800

# ── 切 IP（设备自治；后台只维护城市池） ──
IP_ROTATE_DAYS=2
IP_ROTATE_JITTER_HOURS=4
PROVIDER_BASE_URL=http://127.0.0.1:15650/providers

# ── 素材（内网通道） ──
MATERIAL_DIR=data/materials
MATERIAL_MAX_MB=20

# ── 鉴权 ──
DEVICE_TOKEN_TTL_DAYS=180
# 设备注册时的共享口令（一期内网使用，务必修改）
DEVICE_ENROLL_SECRET=change-me
