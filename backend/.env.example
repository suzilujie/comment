# ────────────────────────────────────────────────────────────────
# comment backend — 环境变量样例
# 用法：复制为 .env 后按实际环境填写（.env 不纳入版本管理）
# ────────────────────────────────────────────────────────────────

# ── 服务 ──
SERVER_HOST=0.0.0.0
SERVER_PORT=15650
LOG_LEVEL=info
LOG_FILE=logs/backend.log

# ── 数据库（PostgreSQL 16） ──
PG_URL=postgres://postgres:postgres@127.0.0.1:5432/comment
PG_POOL_MAX=24
# 语句级超时（毫秒）：200 台规模下防止单条慢查询占住连接池。
# 注意：部署时确认 PostgreSQL 的 max_connections >= 40（24 池 + 余量）。
PG_STATEMENT_TIMEOUT_MS=15000

# ── 派单约束（设计文档 §5.1） ──
#
# ⚠ 本节参数（含下面的「心跳与在线判定」）**已可在管理台「系统设置」页调整**，
#    优先级为：**页面设置 > .env > config.ts 默认值**。
#    这里写的是「初始值 / 兜底」：某一项一旦在页面上改过，就由页面（数据库）说了算，
#    再改 .env 对它不再生效 —— 页面上每项都标了来源，可随时「恢复默认」退回这里。
#    想看**当前真正生效**的值：后台启动日志第一行（"生效参数：…"），或页面上那一列。
#
# ① 单设备日评论上限（需求：单设备 20 条）
#    改名自 DAILY_QUOTA_PER_ACCOUNT（账号实体已移除）；旧键仍兼容读取，但会打启动告警。
DAILY_QUOTA_PER_DEVICE=20
#
# ② 完成间隔 = 「每条评论之间」的时间间隔（需求：可配置，如 1 小时/条、半小时/条）
#    服务端权威：每次**成功**后按 [MIN, MAX] 区间随机算一个 next_eligible_at 写进库，
#    设备下次领取时被它挡住（failed/aborted 不重排，即失败不计间隔）。
#    取值与效果（窗口 08:00–22:00 共 14 小时 = 840 分钟）：
#      30/60  → 平均 45 分钟 → 约 19 条/天   ← 当前默认
#      30/50  → 平均 40 分钟 → 约 20 条/天   ← 想稳定做满 20 条用这个
#      60/60  → 60 分钟/条   → 窗口内最多 14 条（「1 小时/条」）
#      30/30  → 30 分钟/条   → 窗口内最多 28 条，会先撞上日上限 20（「半小时/条」）
INTERVAL_MIN_MINUTES=30
INTERVAL_MAX_MINUTES=60
# ③ 投放时段窗口（00:00–23:59 的分钟数写法）。上面的「最多几条」直接受它限制。
DISPATCH_WINDOW_START=08:00
DISPATCH_WINDOW_END=22:00
# ④ 全局密度：globalWindowSeconds 秒内最多派 globalLimit 条（防多设备扎堆）
GLOBAL_DISPATCH_LIMIT=3
GLOBAL_DISPATCH_WINDOW_SECONDS=300
# ⑤ 单帖间隔：同一帖子两次评论之间至少间隔多久（需求：单帖 10–15 条要拉开发布间隔）。
#    该帖有在途任务时也不再派（否则两台设备会在同一分钟内先后发出去）。
PER_POST_MIN_INTERVAL_MINUTES=15
# ⑥ 同一设备对同一帖的冷却（**自然日，UTC+8**）。
#    需求：单设备对同一帖「一天仅允许评论 1 次」→ 默认 1 = 当天一次。
#    设 2 = 最近两天内不重复（等价于旧的"跨切省周期也不重复"的严格做法）；0 = 不限制。
DEVICE_POST_COOLDOWN_DAYS=1
RECEIPT_TIMEOUT_MINUTES=15

# ── 心跳 ──
HEARTBEAT_SECONDS=30
HEARTBEAT_JITTER_RATIO=0.1
ONLINE_THRESHOLD_SECONDS=90
OFFLINE_ALERT_THRESHOLD_SECONDS=300
OFFLINE_MANUAL_THRESHOLD_SECONDS=1800

# ── 切 IP（设备自治；后台只维护城市池） ──
IP_ROTATE_DAYS=2
IP_ROTATE_JITTER_HOURS=4
PROVIDER_BASE_URL=http://127.0.0.1:15650/providers

# ── 素材（内网通道） ──
MATERIAL_DIR=data/materials
MATERIAL_MAX_MB=20

# ── 鉴权 ──
DEVICE_TOKEN_TTL_DAYS=180
# 设备注册时的共享口令（一期内网使用，务必修改）
DEVICE_ENROLL_SECRET=change-me

# ── 管理台登录（comment/admin-web）──
ADMIN_USERNAME=admin
# 上线务必修改：管理台能下发指令、增删帖子与素材
ADMIN_PASSWORD=admin
# 签发管理台 token 的 HMAC 密钥。**必须自己生成一个**：
#   openssl rand -base64 32
# 留空 / 沿用旧默认值（comment-admin-dev-secret-please-change）时，后台会在每次启动时
# 随机生成一把并打印告警 —— 由于旧默认值写在仓库里，人人可用它离线伪造 token。
ADMIN_TOKEN_SECRET=
ADMIN_TOKEN_TTL_HOURS=12

# ── 跨域（可选）──
# 管理系统与后台不同源时的额外放行来源（逗号分隔）。同源、本机、以及与本后台
# 同一台机器（Origin 的 host == 请求 Host）默认已放行，一般不用填。
# CORS_ALLOWED_ORIGINS=http://192.168.1.20:5273
