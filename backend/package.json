{
  "name": "comment-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "抖音评论区自动化投放系统 - 后台控制平台（Platform）",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun run src/main.ts",
    "test": "bun test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "tsc --noEmit",
    "db:init": "psql \"$PG_URL\" -f sql/schema.sql"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "postgres": "^3.4.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "latest",
    "typescript": "^5.7.3"
  }
}
